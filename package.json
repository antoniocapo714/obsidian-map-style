{
  "name": "obsidian-map-style",
  "version": "0.2.0",
  "private": true,
  "description": "A dark basemap style for MapLibre GL on Protomaps tiles, designed to sit behind data.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "basemap",
    "protomaps",
    "pmtiles",
    "dark",
    "map-style"
  ],
  "homepage": "https://github.com/creative-context/obsidian-map-style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creative-context/obsidian-map-style.git"
  },
  "bugs": {
    "url": "https://github.com/creative-context/obsidian-map-style/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "glyphs": "node scripts/fetch-assets.mjs && .tools/pyenv/bin/python scripts/inter-ttf.py && node scripts/build-glyphs.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "astryx-theme-obsidian": "github:creative-context/astryx-theme-obsidian",
    "fontnik": "^0.7.7",
    "lightningcss": "^1.33.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
